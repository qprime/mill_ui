Checks: >
  -*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -bugprone-unchecked-optional-access,
  -bugprone-easily-swappable-parameters,
  -readability-function-cognitive-complexity,
  -performance-enum-size

# readability-identifier-length: x/y/z/dx/dy and loop i/j are the geometry
#   domain's correct names; renaming to satisfy a length floor hurts the math.
# readability-magic-numbers, cppcoreguidelines-avoid-magic-numbers: fire on
#   0.5 in the shoelace formula and 180.0 in degree conversion; the meaningful
#   constants are already named.
# cppcoreguidelines-avoid-do-while: every hit is doctest's CHECK/REQUIRE
#   expanding to do-while(0), not project code.
# bugprone-unchecked-optional-access: false positives in tests where the
#   dereference is guarded by doctest REQUIRE, which the dataflow analysis
#   cannot see through.
# bugprone-easily-swappable-parameters: the triplicated pocket preamble is now
#   PocketParams (#183), but the check still fires on 14 sites. Eleven are the
#   public plan_* FFI surface and emit_ramp_or_plunge; pybind passes those by
#   keyword (py::arg), so the transposition the check warns about cannot occur
#   at the only call site. The remaining three are pybind's own
#   py::sequence-vs-py::object conversions, not project code. Enabling it would
#   buy no defect prevention and would churn the binding contract.
# readability-function-cognitive-complexity: post_gcode measures 52, almost
#   entirely nesting penalty from its seven inline std::visit lambdas — an
#   artifact of the metric, not real complexity. Enabling the check would
#   red-gate idiomatic variant dispatch.
# performance-enum-size: PocketStrategy is passed by value, never stored in a
#   struct or array, so a narrower base type buys nothing.

HeaderFilterRegex: 'cam/native/cpp/include/millui/.*'
