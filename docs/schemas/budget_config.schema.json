{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACE Context Budget Configuration",
  "type": "object",
  "properties": {
    "focus_history": {"type": "integer", "minimum": 0},
    "direct_files_max": {"type": "integer", "minimum": 0},
    "neighbors_depth": {"type": "integer", "minimum": 0},
    "neighbors_per_file": {"type": "integer", "minimum": 0},
    "neighbor_signature_budget": {"type": "integer", "minimum": 0},
    "docs_tests_budget": {"type": "integer", "minimum": 0},
    "gpt_api": {
      "type": "object",
      "properties": {
        "max_prompt_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 0}
      },
      "required": ["max_prompt_tokens", "max_output_tokens"]
    },
    "codex_cli": {
      "type": "object",
      "properties": {
        "max_prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  },
  "required": [
    "focus_history",
    "direct_files_max",
    "neighbors_depth",
    "neighbors_per_file",
    "neighbor_signature_budget",
    "docs_tests_budget",
    "gpt_api",
    "codex_cli"
  ],
  "additionalProperties": true
}

