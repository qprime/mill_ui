### Phase 3: Add v2 Import Compatibility Shim

Create `v2/__init__.py` as a compatibility layer:

```python
"""Compatibility shim for v2 imports.

v2 modules have been moved to top level. This shim redirects old imports
to new locations for backward compatibility.

Deprecated: Use 'from skills.mill_ui.pml...' instead of 'from skills.mill_ui.v2.pml...'
"""

import sys
from pathlib import Path

# Re-export all moved modules
from skills.mill_ui import (
    adapters,
    ast,
    cli,
    export,
    ir,
    pml,
    resolution,
    validation,
)

# Make old v2.X imports work
sys.modules['skills.mill_ui.v2.adapters'] = adapters
sys.modules['skills.mill_ui.v2.ast'] = ast
sys.modules['skills.mill_ui.v2.cli'] = cli
sys.modules['skills.mill_ui.v2.export'] = export
sys.modules['skills.mill_ui.v2.ir'] = ir
sys.modules['skills.mill_ui.v2.pml'] = pml
sys.modules['skills.mill_ui.v2.resolution'] = resolution
sys.modules['skills.mill_ui.v2.validation'] = validation

__all__ = ['adapters', 'ast', 'cli', 'export', 'ir', 'pml', 'resolution', 'validation']
```

