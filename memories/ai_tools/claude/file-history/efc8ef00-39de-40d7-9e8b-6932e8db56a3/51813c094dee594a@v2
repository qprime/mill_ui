@app.post("/sessions", status_code=201)
async def create_session(request: Request):
    """Create a new session."""
    try:
        body = await request.json()
    except Exception:
        body = {}

    # Parse metadata
    meta_data = body.get("metadata", {})
    metadata = SessionMetadata(
        source=meta_data.get("source"),
        user_id=meta_data.get("user_id"),
        tags=meta_data.get("tags", []),
    )

    session = await store.create(metadata)

    return {
        "session_id": session.id,
        "status": session.status,
        "created_at": session.created_at.isoformat(),
    }


@app.get("/sessions/{session_id}")
async def get_session(session_id: str):
    """Get full session state."""
    session = await store.get(session_id)
    if not session:
        return error_response(
            "session_not_found",
            f"Session {session_id} does not exist",
            404,
        )

    return {
        "session_id": session.id,
        "status": session.status,
        "turns": [
            {
                "id": t.id,
                "index": t.index,
                "user": t.user,
                "assistant": t.assistant,
                "timestamp": t.timestamp.isoformat(),
                "metadata": (
                    {
                        "docs_in_context": t.metadata.docs_in_context,
                        "token_count": t.metadata.token_count,
                        "token_breakdown": t.metadata.token_breakdown,
                        "model": t.metadata.model,
                        "latency_ms": t.metadata.latency_ms,
                    }
                    if t.metadata
                    else None
                ),
            }
            for t in session.turns
        ],
        "distillation": (
            {
                "summary": session.distillation.summary,
                "key_points": session.distillation.key_points,
                "turns_covered": session.distillation.turns_covered,
                "updated_at": session.distillation.updated_at.isoformat(),
            }
            if session.distillation
            else None
        ),
        "metadata": {
            "source": session.metadata.source,
            "user_id": session.metadata.user_id,
            "tags": session.metadata.tags,
        },
        "created_at": session.created_at.isoformat(),
        "updated_at": session.updated_at.isoformat(),
    }


@app.get("/sessions/{session_id}/history")
async def get_session_history(session_id: str):
    """Get lightweight session history for prompt building."""
    session = await store.get(session_id)
    if not session:
        return error_response(
            "session_not_found",
            f"Session {session_id} does not exist",
            404,
        )

    # Calculate token count for serialized history
    turns_data = [
        {
            "id": t.id,
            "index": t.index,
            "user": t.user,
            "assistant": t.assistant,
        }
        for t in session.turns
    ]

    # Estimate tokens for all turn content
    total_tokens = sum(
        estimate_tokens(t.user) + estimate_tokens(t.assistant)
        for t in session.turns
    )

    # Add distillation tokens if present
    if session.distillation:
        total_tokens += estimate_tokens(session.distillation.summary)

    return {
        "session_id": session.id,
        "turns": turns_data,
        "distillation": (
            {
                "summary": session.distillation.summary,
                "key_points": session.distillation.key_points,
                "turns_covered": session.distillation.turns_covered,
                "updated_at": session.distillation.updated_at.isoformat(),
            }
            if session.distillation
            else None
        ),
        "token_count": total_tokens,
    }


@app.post("/sessions/{session_id}/turns", status_code=201)
async def append_turn(session_id: str, request: Request):
    """Append a turn to a session."""
    session = await store.get(session_id)
    if not session:
        return error_response(
            "session_not_found",
            f"Session {session_id} does not exist",
            404,
        )

    if session.status != "active":
        return error_response(
            "session_closed",
            "Cannot append to closed session",
            409,
        )

    try:
        body = await request.json()
    except Exception:
        return error_response(
            "invalid_request",
            "Invalid JSON body",
            400,
        )

    # Validate required fields
    if "user" not in body or "assistant" not in body:
        return error_response(
            "invalid_request",
            "Missing required fields: user, assistant",
            400,
        )

    # Parse turn metadata
    turn_meta = None
    if body.get("metadata"):
        m = body["metadata"]
        logger.info(f"Incoming metadata: {m}")
        turn_meta = TurnMetadata(
            docs_in_context=m.get("docs_in_context"),
            token_count=m.get("token_count"),
            token_breakdown=m.get("token_breakdown"),
            model=m.get("model"),
            latency_ms=m.get("latency_ms"),
        )
        logger.info(f"Created TurnMetadata: token_breakdown={turn_meta.token_breakdown}")

    # Create turn
    turn_index = len(session.turns)
    turn = Turn(
        id=generate_turn_id(turn_index),
        index=turn_index,
        user=body["user"],
        assistant=body["assistant"],
        timestamp=utc_now(),
        metadata=turn_meta,
    )

    await store.append_turn(session_id, turn)

    # Check if distillation should be triggered
    distillation_triggered = False
    if config.distillation_enabled:
        # Re-fetch session to get updated turn count
        session = await store.get(session_id)
        if should_distill(session, config.distillation_threshold):
            try:
                distillation = await distill_session(session, config.sak_url)
                await store.update_distillation(session_id, distillation)
                distillation_triggered = True
                logger.info(f"Distillation triggered for session {session_id}")
            except DistillationError as e:
                logger.warning(f"Auto-distillation failed for session {session_id}: {e.message}")
                # Don't fail the turn append if distillation fails

    return {
        "turn_id": turn.id,
        "index": turn.index,
        "session_id": session_id,
        "distillation_triggered": distillation_triggered,
    }


@app.post("/sessions/{session_id}/distill")
async def trigger_distillation(session_id: str):
    """Manually trigger distillation."""
    session = await store.get(session_id)
    if not session:
        return error_response(
            "session_not_found",
            f"Session {session_id} does not exist",
            404,
        )

    if not session.turns:
        return error_response(
            "invalid_request",
            "Cannot distill session with no turns",
            400,
        )

    try:
        distillation = await distill_session(session, config.sak_url)
        await store.update_distillation(session_id, distillation)

        return {
            "session_id": session_id,
            "distillation": {
                "summary": distillation.summary,
                "key_points": distillation.key_points,
                "turns_covered": distillation.turns_covered,
                "updated_at": distillation.updated_at.isoformat(),
            },
        }

    except DistillationError as e:
        return error_response(
            "distillation_failed",
            e.message,
            502,
            e.details,
        )


@app.delete("/sessions/{session_id}")
async def close_session(session_id: str):
    """Close a session."""
    session = await store.get(session_id)
    if not session:
        return error_response(
            "session_not_found",
            f"Session {session_id} does not exist",
            404,
        )

    try:
        action = await store.close(session_id)
        return {
            "session_id": session_id,
            "status": "closed",
            "action": action,
        }
    except Exception as e:
        return error_response(
            "storage_error",
            f"Failed to close session: {e}",
            500,
        )


