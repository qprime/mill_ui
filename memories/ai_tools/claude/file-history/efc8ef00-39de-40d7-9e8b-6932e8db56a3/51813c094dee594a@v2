"""
Session Manager FastAPI server.
"""

import logging
from contextlib import asynccontextmanager
from typing import Any

from fastapi import FastAPI, Request
from fastapi.responses import JSONResponse

from src.config import Config, get_config
from src.distillation import DistillationError, distill_session, should_distill
from src.models import (
    SessionMetadata,
    Turn,
    TurnMetadata,
    generate_turn_id,
    utc_now,
)
from src.stores import SessionStore, create_store
from src.tokenizer import estimate_tokens

logger = logging.getLogger(__name__)

# Global state
config: Config | None = None
store: SessionStore | None = None


def error_response(code: str, message: str, status_code: int, details: dict | None = None) -> JSONResponse:
    """Create a standardized error response."""
    error_body: dict[str, Any] = {
        "code": code,
        "message": message,
    }
    if details:
        error_body["details"] = details

    return JSONResponse(
        status_code=status_code,
        content={"error": error_body},
    )


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan - initialize on startup."""
    global config, store

    config = get_config()

    # Configure logging
    log_level = getattr(logging, config.log_level.upper(), logging.INFO)
    logging.getLogger().setLevel(log_level)

    # Initialize store
    store = create_store(
        config.persistence_mode,
        file_storage_path=config.file_storage_path,
        artifact_engine_url=config.artifact_engine_url,
    )

    logger.info(f"Session Manager starting on port {config.port}")
    logger.info(f"Persistence mode: {config.persistence_mode}")
    logger.info(f"Distillation enabled: {config.distillation_enabled}")
    logger.info(f"Distillation threshold: {config.distillation_threshold}")

    yield


app = FastAPI(
    title="Session Manager",
    description="Conversational state management for AI/context stacks",
    version="1.0.0",
    lifespan=lifespan,
)


