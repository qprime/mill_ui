@app.get("/personas/{name}")
async def get_persona(name: str):
    """
    Get a persona by name.

    Looks for {name}.json or {name}.md in the personas directory.
    """
    try:
        persona = load_persona(name, config.personas_dir)
        return persona
    except PersonaNotFoundError:
        raise HTTPException(
            status_code=404,
            detail={
                "error": {
                    "code": "NOT_FOUND",
                    "message": f"Persona '{name}' not found",
                }
            },
        )
    except PersonaLoadError as e:
        raise HTTPException(
            status_code=500,
            detail={
                "error": {
                    "code": "LOAD_ERROR",
                    "message": str(e),
                }
            },
        )


# -----------------------------------------------------------------------------
# Chat (Model Gateway with SSE Streaming)
# -----------------------------------------------------------------------------


@app.post("/chat")
async def chat(request: Request):
    """
    Chat endpoint with SSE streaming.

    Request:
    {
        "model": "gpt-4o-mini",
        "messages": [
            {"role": "system", "content": "..."},
            {"role": "user", "content": "..."}
        ],
        "stream": true
    }

    Response: SSE stream with events:
    - event: chunk, data: {"content": "..."}
    - event: done, data: {"total_tokens": ...}
    - event: error, data: {"code": "...", "message": "..."}
    """
    try:
        body = await request.json()
    except Exception:
        return error_response("INVALID_REQUEST", "Invalid JSON body", 400)

    model = body.get("model", config.default_model)
    messages = body.get("messages", [])
    stream = body.get("stream", True)

    logger.info(f"Chat request using model: {model}")

    if not messages:
        return error_response("INVALID_REQUEST", "Messages required", 400)

    # Non-streaming: return full response
    if not stream:
        try:
            # Use simple chat for non-streaming
            user_message = messages[-1].get("content", "") if messages else ""
            system_content = None
            for msg in messages:
                if msg.get("role") == "system":
                    system_content = msg.get("content")
                    break

            response = await model_gateway.chat(
                model=model,
                message=user_message,
                context=system_content,
            )
            return {"content": response}
        except Exception as e:
            logger.error(f"Model call failed: {e}")
            return error_response("MODEL_FAILED", str(e), 502)

    # Streaming: return SSE
    async def event_generator() -> AsyncGenerator[dict[str, str], None]:
        total_tokens = 0
        try:
            async for chunk in model_gateway.stream_chat(
                model=model,
                messages=messages,
            ):
                total_tokens += len(chunk.split())  # Rough token estimate
                yield {
                    "event": "chunk",
                    "data": json.dumps({"content": chunk}),
                }

            yield {
                "event": "done",
                "data": json.dumps({"total_tokens": total_tokens}),
            }

        except Exception as e:
            logger.error(f"Streaming error: {e}")
            yield {
                "event": "error",
                "data": json.dumps({
                    "code": "MODEL_FAILED",
                    "message": str(e),
                }),
            }

    return EventSourceResponse(event_generator())


# -----------------------------------------------------------------------------
# Model Registry
# -----------------------------------------------------------------------------


@app.get("/models")
async def list_models(vendor: str | None = None):
    """
    List available models across all vendors.

    Query params:
    - vendor: Filter by vendor ("openai", "anthropic")

    Returns model list with registry status to show data freshness.
    """
    models = model_registry.get_models(vendor=vendor)
    status = model_registry.get_status()

    return {
        "models": [
            {
                "id": m.id,
                "vendor": m.vendor,
                "display_name": m.display_name,
                "created_at": m.created_at,
                "capabilities": m.capabilities,
            }
            for m in models
        ],
        "registry_status": status,
    }


@app.get("/models/{model_id}")
async def get_model_details(model_id: str):
    """
    Get details for a specific model.

    Args:
        model_id: Model identifier (e.g., "gpt-5.2", "claude-sonnet-4-20250514")
    """
    model = model_registry.get_model(model_id)
    if not model:
        raise HTTPException(
            status_code=404,
            detail={
                "error": {
                    "code": "MODEL_NOT_FOUND",
                    "message": f"Model '{model_id}' not found in registry",
                }
            },
        )

    return {
        "id": model.id,
        "vendor": model.vendor,
        "display_name": model.display_name,
        "created_at": model.created_at,
        "capabilities": model.capabilities,
    }


@app.post("/models/refresh")
async def refresh_models(request: Request):
    """
    Force refresh models from vendor APIs.

    Body (optional):
    {
        "vendor": "openai"  // or "anthropic", or omit for all vendors
    }

    Returns updated registry status.
    """
    try:
        body = await request.json()
        vendor = body.get("vendor")
    except Exception:
        vendor = None

    try:
        if vendor:
            if vendor == "openai":
                await model_registry._refresh_openai()
            elif vendor == "anthropic":
                await model_registry._refresh_anthropic()
            else:
                raise HTTPException(
                    status_code=400,
                    detail={
                        "error": {
                            "code": "INVALID_VENDOR",
                            "message": f"Unknown vendor: {vendor}",
                        }
                    },
                )
        else:
            await model_registry.refresh_all()

        return {
            "status": "refreshed",
            "registry_status": model_registry.get_status(),
        }

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Model refresh failed: {e}")
        return error_response("REFRESH_FAILED", str(e), 502)


