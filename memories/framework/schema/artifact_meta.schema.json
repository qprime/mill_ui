{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtifactMeta",
  "type": "object",
  "required": [
    "id",
    "purpose",
    "title",
    "hashes"
  ],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string"},
    "purpose": {"type": "string"},
    "title": {"type": "string"},
    "produced_by": {
      "type": "object",
      "properties": {
        "action_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "inputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "properties": {
        "sha256": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
