    "inputs": {"type": "object"},
    "budgets": {"type": "object"},
    "drops": {"type": "array", "items": {"type": "object"}},
    "prompt_path": {"type": "string"},
    "prompt_sha256": {"type": "string"},
    "timestamp": {"type": "string"}
  },
  "additionalProperties": false
}
