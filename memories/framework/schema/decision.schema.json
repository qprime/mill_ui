{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "required": [
    "id",
    "action_id",
    "approver",
    "signature",
    "reason",
    "timestamp"
  ],
  "properties": {
    "id": {"type": "string"},
    "action_id": {"type": "string"},
    "approver": {
      "type": "object",
      "required": ["actor_id"],
      "properties": {
        "actor_id": {"type": "string"}
      }
    },
    "signature": {"type": "string"},
    "reason": {"type": "string"},
    "timestamp": {"type": "string"},
    "policy_check_path": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
