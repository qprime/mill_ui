{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://cliff.local/schemas/tool_log.schema.json",
    "title": "Tool Log Entry",
    "description": "Schema for tool log entries captured via CLI or voice input.",
    "type": "object",
    "properties": {
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 timestamp of the log entry."
      },
      "tool_name": {
        "type": "string",
        "description": "Name of the tool."
      },
      "model": {
        "type": "string",
        "description": "Model identifier of the tool."
      },
      "serial": {
        "type": "string",
        "description": "Serial number of the tool."
      },
      "notes": {
        "type": "string",
        "description": "Additional notes or comments."
      },
      "source": {
        "type": "string",
        "enum": ["voice", "cli"],
        "description": "Origin of the log entry."
      }
    },
    "required": ["timestamp", "tool_name", "model", "serial", "source"],
    "additionalProperties": false
  }
  