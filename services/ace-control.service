[Unit]
Description=AceControl Web Interface
After=network.target

[Service]
User=squinlan
WorkingDirectory=/home/squinlan/cliff_ai
Environment="PYTHONPATH=/home/squinlan/cliff_ai"
Environment="VIRTUAL_ENV=/home/squinlan/cliff_ai/.venv"
Environment="PATH=/home/squinlan/cliff_ai/.venv/bin:$PATH"
EnvironmentFile=/home/squinlan/.config/ace/env
ExecStart=/home/squinlan/cliff_ai/.venv/bin/python /home/squinlan/cliff_ai/run.py web
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
