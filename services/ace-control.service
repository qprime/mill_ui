[Unit]
Description=AceControl Web Interface
After=network.target

[Service]
User=squinlan
WorkingDirectory=/home/squinlan/cliff_ai
Environment="FLASK_APP=interfaces.app"
Environment="VIRTUAL_ENV=/home/squinlan/cliff_ai/.venv"
Environment="PATH=/home/squinlan/cliff_ai/.venv/bin:%PATH%"
ExecStart=/home/squinlan/cliff_ai/.venv/bin/flask run --host 0.0.0.0 --port 8050
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
