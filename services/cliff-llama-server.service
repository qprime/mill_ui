[Unit]
Description=CLIFF LLaMA-Server (Phi-3.5)
After=network.target

[Service]
User=squinlan
WorkingDirectory=/home/squinlan/cliff_ai/llama_server
ExecStart=/home/squinlan/cliff_ai/llama_server/start_llama_server.sh
Environment="LD_LIBRARY_PATH=/home/squinlan/cliff_ai/models/phi2/llama.cpp/build/bin"

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
