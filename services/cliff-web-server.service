[Unit]
Description=Cliff Web Server (Flask for Cliff Apps)
After=network.target

[Service]
User=squinlan
WorkingDirectory=/home/squinlan/cliff_ai
# If you use a virtualenv, activate it here (optional)
Environment="VIRTUAL_ENV=/home/squinlan/cliff_ai/.venv"
Environment="PATH=/home/squinlan/cliff_ai/.venv/bin:%PATH%"
ExecStart=/usr/bin/python3 /home/squinlan/cliff_ai/run.py web
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
