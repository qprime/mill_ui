{
  "style_id": "mdf_faux_shaker_recessed",
  "version": 1,
  "units": "mm",

  "ops": [
    "pocket_border",
    "raster_center",
    "corner_anchor_pockets",
    "profile_cut",
    "BACKSIDE: hinge_bores"
  ],

  "border": {
    "target_ratio": 0.18,
    "min_mm": 50.0,
    "max_mm": 90.0,
    "clearance_mm": 2.0
  },

  "panel_depth": {
    "target_of_thickness": 0.6,
    "min_mm": 8.0,
    "max_mm": 14.0,
    "safety_floor_mm": 2.0
  },

  "corner_anchors": {
    "enabled_default": true,
    "face_default": "front",
    "placement_mode_default": "xy",
    "inset_xy_mm_default": { "dx": 18.0, "dy": 18.0 },
    "inset_diagonal_mm_default": 22.0,
    "diameter_mm_default": 12.0,
    "depth_mm_default": 5.0,
    "clearance_mm": 2.0
  },

  "hinge": {
    "enabled_default": false,
    "diameter_mm": 35.0,
    "depth_mm": 13.0,
    "edge_offsets_mm": [100.0, "mirror"],
    "from_side": "left_right",
    "min_spacing_mm": 75.0
  },

  "multi_tool": {
    "enabled_default": true,
    "stages": [
      { "name": "rough_panel",  "tool_id": "half_flat_12p7",  "stock_to_leave_mm": 0.6 },
      { "name": "finish_panel", "tool_id": "quarter_flat_6p35", "stock_to_leave_mm": 0.0 },
      { "name": "profile_cut",  "tool_id": "quarter_flat_6p35", "onion_skin_mm": 0.6 }
    ],
    "hinge_stage": { "tool_id": "boring_35mm", "job": "back" }
  },

  "defaults": {
    "tabs": true,
    "tab": { "width_mm": 10.0, "height_mm": 2.0, "count": 6 },
    "onion_skin_mm": 0.6
  },

  "constraints": {
    "min_feature_width_factor_of_tool": 2.0
  }
}
