{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/order.schema.json",
  "title": "Door Order",
  "type": "object",
  "required": ["width_mm", "height_mm", "thickness_mm"],
  "properties": {
    "width_mm": { "type": "number", "exclusiveMinimum": 0 },
    "height_mm": { "type": "number", "exclusiveMinimum": 0 },
    "thickness_mm": { "type": "number", "exclusiveMinimum": 0 },

    "panel_depth_mm": { "type": "number", "minimum": 0 },

    "hinge_bores": { "type": "boolean" },
    "hinge_side": { "type": "string", "enum": ["left", "right"] },
    "hinge_offsets_mm": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },

    "corner_anchors": {
      "type": "object",
      "required": ["enabled", "face", "placement_mode"],
      "properties": {
        "enabled": { "type": "boolean" },
        "face": { "type": "string", "enum": ["front", "back"] },
        "placement_mode": { "type": "string", "enum": ["xy", "diagonal"] },

        "inset_xy_mm": {
          "type": "object",
          "properties": {
            "dx": { "type": "number", "exclusiveMinimum": 0 },
            "dy": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "inset_diagonal_mm": { "type": "number", "exclusiveMinimum": 0 },

        "diameter_mm": { "type": "number", "exclusiveMinimum": 0 },
        "depth_mm": { "type": "number", "minimum": 0 },
        "type": { "type": "string", "enum": ["washer", "magnet"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "placement_mode": { "const": "xy" } } },
          "then": { "required": ["inset_xy_mm"] }
        },
        {
          "if": { "properties": { "placement_mode": { "const": "diagonal" } } },
          "then": { "required": ["inset_diagonal_mm"] }
        }
      ]
    },

    "tool_strategy": { "type": "string", "enum": ["single", "multi"] },
    "use_back_hinge_job": { "type": "boolean" },

    "origin": { "type": "string", "enum": ["lower_left"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
